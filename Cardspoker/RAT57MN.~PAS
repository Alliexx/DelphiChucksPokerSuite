  if club < 20 then
    begin
      crdts:=crdts+club;
      club:=club-club;
      edit16.text:=inttostr(crdts);
      edit17.Text:=inttostr(club);
    end;
  if club >= 20 then
    begin
      crdts:=crdts+20;
      club:=club-20;
      edit16.text:=inttostr(crdts);
      edit17.Text:=inttostr(club);
    end;
end;

procedure TformMain.Button6Click(Sender: TObject);
