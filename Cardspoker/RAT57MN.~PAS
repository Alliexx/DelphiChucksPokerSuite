procedure TformMain.Button9Click(Sender: TObject);   { clubgame }
  var
    x,j:integer;
begin
  if crdts < 20 then Button5Click(Sender);
  if crdts < 20 then
    begin
      while crdts < 20 do Button4Click(Sender);
    end;
  j:=0;
  while j < 20 do
    begin
  x := 1+random(10000);
  if x = 10000 then
    begin
      crdts:=crdts-1;
      edit16.Text:=inttostr(crdts);
    end;
  if x < 10000 then
    begin
      crdts:=crdts-1;
      club:=club+1;
      edit16.Text:=inttostr(crdts);
      edit17.Text:=inttostr(club);
    end;
    j:=j+1;
  end;

end;

